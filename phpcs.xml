<?xml version="1.0"?>
<ruleset name="CartShift">
    <description>CartShift PHPCS configuration</description>
    <rule ref="WordPress"/>

    <!-- PDO required for external OpenCart DB — $wpdb is WP-only -->
    <rule ref="WordPress.DB.RestrictedClasses.mysql__PDO">
        <exclude-pattern>src/Core/DatabaseConnector.php</exclude-pattern>
        <exclude-pattern>src/Admin/AjaxHandler.php</exclude-pattern>
    </rule>

    <!-- Table names from $wpdb->prefix are safe; %i needs WP 6.2+ (our min is 5.8) -->
    <rule ref="WordPress.DB.PreparedSQL.InterpolatedNotPrepared">
        <exclude-pattern>src/</exclude-pattern>
        <exclude-pattern>scripts/</exclude-pattern>
    </rule>

    <!-- CLI build scripts — not web-facing, WP escaping irrelevant -->
    <rule ref="WordPress.Security.EscapeOutput">
        <exclude-pattern>scripts/</exclude-pattern>
    </rule>

    <!-- error_log() is production server logging, not debug output -->
    <rule ref="QITStandard.PHP.DebugCode.DebugFunctionFound">
        <exclude-pattern>src/Admin/AdminPage.php</exclude-pattern>
        <exclude-pattern>src/Admin/AjaxHandler.php</exclude-pattern>
        <exclude-pattern>src/Core/CronManager.php</exclude-pattern>
        <exclude-pattern>src/Core/SqlImporter.php</exclude-pattern>
    </rule>
</ruleset>
